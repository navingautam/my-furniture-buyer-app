# Copy this file to .env.local and fill in the values.
# .env.local is already in .gitignore so these secrets never get committed.

# Any random string, 32+ characters — used to encrypt the login session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only needed to run scripts/sync-catalog-from-mongo.mjs (loading the product catalogue).
MONGODB_URI=

# Azure OpenAI (GPT-5 mini) access — not wired into any feature yet.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
